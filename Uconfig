// Kernel configuration for Utopia. For `uconfig`'s parser and related code, 
// please see `tools/uconfig`.

proj "Utopia"

// ----- syscalls

opt CONFIG_SYSCALLS(null) -> menu {
    display: "Syscalls"
}

opt CONFIG_SYSCALL_ABI_LINUX(bool) {
    display: "Linux syscall ABI support"
    default: true
    within: CONFIG_SYSCALLS
}

// ----- devices

opt CONFIG_DEVICES(null) -> menu {
    display: "Devices"
}

// ----- io

opt CONFIG_IO(null) -> menu {
    display: "I/O devices"
    within: CONFIG_DEVICES
}

opt CONFIG_IO_PRINT_EXTRA_DEBUG_MESSAGES(bool) {
    display: "Print messages in extra debugging level"
    default: false
    within: CONFIG_IO
}

opt CONFIG_IO_SCREEN_SERIAL_MIRRRORING(bool) {
    display: "Print screen messages to serial output"
    default: true
    within: CONFIG_IO
}

opt CONFIG_IO_PS2_KEYBOARD_SUPPORT(bool) {
    display: "Enable PS/2 keyboard support (on supported architectures)"
    default: true
    within: CONFIG_IO
}

// ----- pci

opt CONFIG_PCI(bool) {
    display: "Scan PCI devices"
    default: true
    within: CONFIG_DEVICES
}

// ----- smp

opt CONFIG_SMP(bool) {
    display: "Symmetric multiprocessing support"
    default: true
}
