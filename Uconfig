// Kernel configuration for Utopia. For `uconfig`'s parser and 
// related code, please see `tools/uconfig`

proj "Utopia"

opt CONFIG_SYSCALL_ABI_LINUX(bool) {
    display: "Linux syscall ABI support"
    default: true
}

opt CONFIG_SYSCALL_SMP(bool) {
    display: "Symmetric multiprocessing support"
    default: true
}
